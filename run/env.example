# Copy to run/.env (or export the variables) and adjust. Absolute host paths.
# DenSea-Aggregated package: contains annotations/ and images/; synthetic batches go in synthetic/.
DATA_ROOT=/path/to/densea-aggregated
# This repository.
KIT_DIR=/path/to/densea-benchmark
# Weights, logs and predictions.
RUNS_DIR=/path/to/runs
# Folder that holds the checkouts of densea-rtdetrv2, densea-rfdetr and densea-diffusiondet.
REPOS_DIR=/path/to/repos
